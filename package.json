{
    "name": "ezviz-rag-agent-monorepo",
    "private": true,
    "scripts": {
        "api:dev": "pnpm -r api:dev",
        "api:build": "pnpm -r api:build",
        "typecheck": "pnpm -r typecheck",
        "mcp:dev": "pnpm -r mcp:dev",
        "mcp:build": "pnpm -r mcp:build",
        "crawl:sdk": "pnpm -r crawl:sdk",
        "partner-docs:validate": "node --experimental-strip-types scripts/partner-docs/validate.ts",
